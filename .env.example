# Copy to .env and adjust. Never commit real secrets.
# All variables are optional; defaults live in config.py.
QPI_BASE_CURRENCY=BRL
QPI_SEED=42
QPI_N_SIMULATIONS=20000
QPI_HORIZON_DAYS=252
QPI_TRADING_DAYS=252
QPI_PERIOD=5y
# Annual risk-free rate as a decimal (e.g. 0.105 = 10.5% a.a.). If unset, a
# clearly-labelled demonstration fallback is used and flagged in every report.
# QPI_RISK_FREE_RATE=0.105
QPI_OUTPUT_DIR=outputs
QPI_CACHE_DIR=.cache/market_data
QPI_CACHE_TTL_HOURS=24
